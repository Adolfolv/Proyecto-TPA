    +nombre_usuario(usuario)
  }

  class Trayectoria {
    +coordenada_real(punto)
    +punto_relativo_desde_coordenada(latitud, longitud)
    +limpiar_puntos(puntos, umbral)
    +calcular_trayectoria(inicio, destino)
