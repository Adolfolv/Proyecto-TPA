  }

  class CalculadoraViaje {
    -trayectoria
    +__init__(trayectoria)
    +calcular_tiempo_por_km(distancia)
    +calcular_km_trayectoria(ruta_relativa)
    +calcular_km_entre_coordenadas(inicio, destino)
    +calcular_tiempos_viaje(km_para_llegar, km_transportando)
