@startuml
skinparam classAttributeIconSize 0
title UML de clases - Proyecto movilidad

package "Abstracciones" {
  abstract class TarjetaBase {
    -clase_validador_numero
    -longitud_cvv
    -validador_numero
    +__init__()
    +numero_valido(numero)
  }

  abstract class Validador { +validar(datos) }
  abstract class Buscador { +buscar(...) }
  abstract class OperacionBilletera { +ejecutar(solicitud) }
  abstract class NavegadorAbstracto { +navegar(destino) }

  abstract class RutaNavegacion {
    -rutas_registradas
    -destino
    -navegacion
    +__init__(navegacion)
    +limpiar_pantalla()
    +mostrar(vista, titulo)
    +ejecutar()
  }
}

