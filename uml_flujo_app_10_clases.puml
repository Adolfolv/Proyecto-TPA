@startuml
skinparam classAttributeIconSize 0
title UML flujo app - maximo 10 clases

class Navegacion {
  -usuario_actual
  -dependencias
  -navegador
  +iniciar()
  +navegar(destino)
  +establecer_usuario_actual(usuario)
  +obtener_usuario_actual()
}

class DependenciasAplicacion {
  -repositorios
  -servicios
  -controladores
  +__init__()
}

class Vista {
  -navegar
  -usuario_actual
  -controladores
  +iniciar_sesion()
  +registrar()
  +actualizar_billetera()
  +buscar_vehiculos()
  +confirmar_viaje()
}

class Controlador {
  -servicio_usuario
  -servicio_billetera
  -servicio_viaje
  +iniciar_sesion(correo, contrasena)
  +registrar_pasajero(datos)
  +obtener_resumen(usuario)
  +buscar_vehiculos_pasajero(...)
  +iniciar_viaje_conductor(...)
}

class ServicioUsuario {
  -repositorio_usuario
  -fabrica_usuario
  -validaciones_usuario
  -validaciones_conductor
  +iniciar_sesion(correo, contrasena)
  +registrar_pasajero(datos)
  +registrar_conductor(datos)
}

class ServicioBilletera {
  -repositorio_billetera
  -operaciones
  +obtener_billetera(usuario)
  +obtener_resumen(usuario)
  +guardar(usuario, billetera)
  +ejecutar(nombre_operacion, usuario, monto)
}

class ServicioViaje <<Facade>> {
  -servicio_pasajero
  -servicio_conductor
  -servicio_comun
  -servicio_pagos
  +buscar_vehiculos(...)
  +confirmar_viaje_pasajero(...)
  +buscar_pasajeros(...)
  +iniciar_viaje_conductor(...)
}

class Repositorio {
  -archivo
  -usuarios
  -billeteras
  -cargado
  +cargar()
  +guardar()
  +listar()
  +obtener(usuario)
  +guardar_por_usuario(id_usuario, billetera)
}

class Modelo {
  +Usuario / Pasajero / Conductor
  +Billetera / Tarjetas / Transaccion
  +VehiculoDisponible
  +PasajeroEncontrado
  +Viaje / ResultadoViaje
}

class Validaciones {
  +validar(usuario, confirmar_contrasena)
  +validar_busqueda_vehiculos(...)
  +validar_pago_pasajero(servicio_billetera, usuario)
  +validar_abono_conductor(servicio_billetera, usuario)
  +validar_tarjeta(...)
}

Navegacion *-- DependenciasAplicacion
Navegacion --> Vista : muestra pantallas
DependenciasAplicacion *-- Controlador
DependenciasAplicacion *-- ServicioUsuario
DependenciasAplicacion *-- ServicioBilletera
DependenciasAplicacion *-- ServicioViaje
DependenciasAplicacion *-- Repositorio

Vista --> Controlador : envia acciones del usuario
Controlador --> ServicioUsuario : login / registro
Controlador --> ServicioBilletera : tarjetas / saldo
Controlador --> ServicioViaje : busqueda / viaje

ServicioUsuario --> Repositorio : guarda y consulta usuarios
ServicioBilletera --> Repositorio : guarda y consulta billeteras
ServicioViaje --> ServicioBilletera : cobra / abona pagos

ServicioUsuario --> Validaciones
ServicioBilletera --> Validaciones
ServicioViaje --> Validaciones

Repositorio --> Modelo : persiste objetos
ServicioUsuario --> Modelo : crea usuarios
ServicioBilletera --> Modelo : crea billeteras / tarjetas
ServicioViaje --> Modelo : crea viajes / resultados

@enduml
